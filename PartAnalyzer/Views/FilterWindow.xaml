<Window x:Class="PartAnalyzer.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Filters"
        MinHeight="520"
        MinWidth="780"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#F7F7F7">
        <Border DockPanel.Dock="Bottom"
                Background="#E9ECEF"
                BorderBrush="#D0D5DA"
                BorderThickness="0,1,0,0"
                Padding="12">
            <DockPanel>
                <TextBlock Text="{Binding ActiveFilterSummary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Clear All Filters"
                            Command="{Binding ClearAllFiltersCommand}"
                            Padding="10,5"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            Padding="14,5"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DADDE1"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Available Columns" Style="{StaticResource PanelTitle}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AvailableFilters}"
                             SelectedItem="{Binding SelectedAvailableFilter}"
                             DisplayMemberPath="DisplayName"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                    <Button Grid.Row="2"
                            Content="Add Column"
                            Command="{Binding AddFilterCommand}"
                            IsEnabled="{Binding CanAddFilter}"
                            Padding="10,5"
                            Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#DADDE1"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Added Columns" Style="{StaticResource PanelTitle}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ActiveFilters}"
                             SelectedItem="{Binding SelectedActiveFilter}"
                             DisplayMemberPath="DisplayName"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                    <Button Grid.Row="2"
                            Content="Remove Column"
                            Command="{Binding RemoveSelectedFilterCommand}"
                            Padding="10,5"
                            Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DADDE1"
                    BorderThickness="1"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Selected Column Filter" Style="{StaticResource PanelTitle}" />
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedActiveFilter.DisplayName, TargetNullValue=Select an added column}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedActiveFilter.FilterKindLabel}"
                                   Foreground="#555555"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Visibility="{Binding SelectedFilterUsesText, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Text" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedActiveFilter.Text, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="260" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Visibility="{Binding SelectedFilterUsesRange, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Range" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding SelectedActiveFilter.MinimumText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120"
                                     Margin="0,0,8,0" />
                            <TextBox Text="{Binding SelectedActiveFilter.MaximumText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="4"
                          Visibility="{Binding SelectedFilterUsesValues, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Search Values" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedActiveFilter.ValueSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="260" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelectedActiveFilter.ValueOptions}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayWithCount}"
                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedActiveFilter.ValidationMessage}"
                                   Foreground="#B00020"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button Content="Clear Current Filter"
                                Command="{Binding ClearSelectedFilterCommand}"
                                Padding="10,5"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
