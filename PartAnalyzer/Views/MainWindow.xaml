<Window x:Class="PartAnalyzer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Part Analyzer" Width="860" Height="680"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Part Analyzer" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><GroupBox Header="Workbook" Padding="14" Margin="0,0,0,12"><StackPanel><Button Content="Select Workbook" Command="{Binding ImportWorkbookCommand}" IsEnabled="{Binding CanStartInspection}" Width="145" HorizontalAlignment="Left"/><TextBlock Text="{Binding CurrentWorkbook.FileName, TargetNullValue=No workbook selected}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock Text="{Binding CurrentWorkbook.FullPath}" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="Worksheet" Padding="14" Margin="0,0,0,12"><StackPanel><ComboBox ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedWorksheet}" DisplayMemberPath="DisplayName" Width="360" HorizontalAlignment="Left"/><CheckBox Content="Include hidden rows and columns" IsChecked="{Binding IncludeHiddenRowsAndColumns}" Margin="0,10,0,0"/><Button Content="Validate and Load Worksheet" Command="{Binding LoadDataCommand}" IsEnabled="{Binding CanLoadData}" Width="190" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></GroupBox><GroupBox Header="Session" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding DataStateMessage}" FontWeight="SemiBold"/><TextBlock Text="MAVL is calculated from the complete eligible worksheet." Margin="0,6,0,0"/></StackPanel></GroupBox><GroupBox Header="Filters and Presets" Padding="14" Margin="0,0,0,12"><DockPanel><TextBlock Text="{Binding ConstrainedFilterSummary}" VerticalAlignment="Center"/><Button Content="Configure Filters" Click="OpenFilters_Click" IsEnabled="{Binding HasValidatedProcessingSession}" DockPanel.Dock="Right" Padding="12,6"/></DockPanel></GroupBox><GroupBox Header="Export" Padding="14"><StackPanel><Button Content="Export Filtered Workbook" Command="{Binding ExportFilteredWorkbookCommand}" IsEnabled="{Binding CanExportFilteredWorkbook}" Width="190" HorizontalAlignment="Left"/><TextBlock Text="Exports a new filtered workbook with MAVL." Margin="0,6,0,0"/></StackPanel></GroupBox><Border Background="#EEF1F3" Padding="12" Margin="0,14,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></Window>
