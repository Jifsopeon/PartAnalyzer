<Window x:Class="PartAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Part Analyzer"
        MinHeight="620"
        MinWidth="900"
        Height="720"
        Width="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#F7F7F7">
        <Border DockPanel.Dock="Top" Background="#20242A" Padding="18,14">
            <TextBlock Text="Part Analyzer" Foreground="White" FontSize="22" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E9ECEF" BorderBrush="#D0D5DA" BorderThickness="0,1,0,0" Padding="14,9">
            <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </Border>

        <TabControl Margin="14" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Import">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button Content="Import Excel File"
                                Command="{Binding ImportWorkbookCommand}"
                                IsEnabled="{Binding CanStartInspection}"
                                Padding="14,7"
                                DockPanel.Dock="Left" />
                        <Button Content="Load Data"
                                Command="{Binding LoadDataCommand}"
                                IsEnabled="{Binding CanLoadData}"
                                Padding="14,7"
                                Margin="10,0,0,0"
                                DockPanel.Dock="Left" />
                        <CheckBox Content="Ignore hidden Excel rows"
                                  IsChecked="{Binding IgnoreHiddenRows}"
                                  VerticalAlignment="Center"
                                  Margin="18,0,0,0" />
                        <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                     Width="180"
                                     Height="14"
                                     HorizontalAlignment="Right"
                                     DockPanel.Dock="Right" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#DADDE1" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Workbook" Style="{StaticResource SectionTitle}" />

                                    <TextBlock Text="File" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding CurrentWorkbook.FileName, TargetNullValue=No workbook selected}" Style="{StaticResource ValueText}" Margin="0,0,0,12" />

                                    <TextBlock Text="Source Path" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding CurrentWorkbook.FullPath, TargetNullValue=-}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <TextBlock Text="Worksheet" Style="{StaticResource LabelText}" />
                                    <ComboBox ItemsSource="{Binding Worksheets}"
                                              SelectedItem="{Binding SelectedWorksheet}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="260"
                                              Margin="0,0,0,16" />

                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Used Rows" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.UsedRowCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Data Rows" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.TotalDataRowCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Used Columns" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.UsedColumnCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Hidden Rows" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.HiddenRowCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Eligible Data Rows" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheetEligibleRowCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Header Row" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.HeaderRowNumber, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Hidden Columns" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.HiddenColumnCount, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,12">
                                            <TextBlock Text="Visibility" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SelectedWorksheet.Visibility, TargetNullValue=-}" Style="{StaticResource ValueText}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Import Policy" Style="{StaticResource LabelText}" Margin="0,8,0,3" />
                                    <TextBlock Text="{Binding HiddenRowPolicySummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="#DADDE1" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Detected Columns" Style="{StaticResource SectionTitle}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding SelectedWorksheet.Headers}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" DisplayMemberBinding="{Binding ColumnIndex}" Width="55" />
                                            <GridViewColumn Header="Column" DisplayMemberBinding="{Binding ColumnLetter}" Width="80" />
                                            <GridViewColumn Header="Header" DisplayMemberBinding="{Binding DisplayName}" Width="420" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Data">
                <Grid Background="White" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding DataStateMessage}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="Load Data"
                                Command="{Binding LoadDataCommand}"
                                IsEnabled="{Binding CanLoadData}"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="Set Filters"
                                Padding="12,6"
                                Click="OpenFilters_Click"
                                DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ActiveFilterSummary}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </DockPanel>

                    <DataGrid x:Name="RawDataGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding DataRowsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ColumnWidth="160" />

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="First" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanMovePreviousPage}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanMovePreviousPage}" Padding="10,5" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding PageNumberSummary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanMoveNextPage}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Last" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanMoveNextPage}" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Grouped Parts">
                <Grid Background="White" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding GroupedPartsStateMessage}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AnalysisSummary}"
                                       Foreground="#555555"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Analyze Parts"
                                Command="{Binding AnalyzePartsCommand}"
                                IsEnabled="{Binding CanAnalyzeParts}"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="Set Filters"
                                Padding="12,6"
                                Click="OpenFilters_Click"
                                DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ActiveFilterSummary}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Part Summaries" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding GroupedPartsRowsView}"
                              SelectedItem="{Binding SelectedGroupedPart}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Identifier" Binding="{Binding PartIdentifier}" Width="220" />
                            <DataGridTextColumn Header="Rows" Binding="{Binding PartRowCount}" Width="90" />
                            <DataGridTextColumn Header="Manufacturers" Binding="{Binding ManufacturerCount}" Width="130" />
                            <DataGridTextColumn Header="Duplicate?" Binding="{Binding IsDuplicatePart}" Width="110" />
                            <DataGridTextColumn Header="Multiple Manufacturer?" Binding="{Binding HasMultipleManufacturers}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4" Margin="0,10,0,12">
                        <TextBlock Text="{Binding GroupedPageSummary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="First" Command="{Binding FirstGroupedPageCommand}" IsEnabled="{Binding CanMovePreviousGroupedPage}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Previous" Command="{Binding PreviousGroupedPageCommand}" IsEnabled="{Binding CanMovePreviousGroupedPage}" Padding="10,5" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding GroupedPageNumberSummary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Next" Command="{Binding NextGroupedPageCommand}" IsEnabled="{Binding CanMoveNextGroupedPage}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Last" Command="{Binding LastGroupedPageCommand}" IsEnabled="{Binding CanMoveNextGroupedPage}" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="5" Text="Selected Part Detail" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <DataGrid x:Name="PartDetailGrid"
                              Grid.Row="6"
                              ItemsSource="{Binding PartDetailRowsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ColumnWidth="160" />
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Border Background="White" BorderBrush="#DADDE1" BorderThickness="1" Padding="18" Margin="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Ignore hidden Excel rows"
                                      IsChecked="{Binding IgnoreHiddenRows}"
                                      Margin="0,0,0,14" />
                            <TextBlock Text="Last Import Directory" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding LastImportDirectory, TargetNullValue=-}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <TextBlock Text="Preferred Worksheet" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding PreferredWorksheet, TargetNullValue=-}" TextWrapping="Wrap" Margin="0,0,0,22" />

                            <TextBlock Text="Data Mapping" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Primary Part Identifier" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding MappingColumns}"
                                      SelectedItem="{Binding SelectedPrimaryPartColumn}"
                                      DisplayMemberPath="GridHeader"
                                      MinWidth="360"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Manufacturer" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding MappingColumns}"
                                      SelectedItem="{Binding SelectedManufacturerColumn}"
                                      DisplayMemberPath="GridHeader"
                                      MinWidth="360"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Manufacturer Part Number" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding MappingColumns}"
                                      SelectedItem="{Binding SelectedManufacturerPartNumberColumn}"
                                      DisplayMemberPath="GridHeader"
                                      MinWidth="360"
                                      Margin="0,0,0,12" />

                            <Button Content="Analyze Parts"
                                    Command="{Binding AnalyzePartsCommand}"
                                    IsEnabled="{Binding CanAnalyzeParts}"
                                    Padding="12,6"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Export" IsEnabled="False">
                <Grid Background="White" Margin="12">
                    <TextBlock Text="Export is not available in Phase 1."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="#555555" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
