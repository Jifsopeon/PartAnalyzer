<Window x:Class="ReportExtract.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ReportExtract" Width="860" Height="680">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="24" IsEnabled="{Binding IsMainInteractionEnabled, Mode=OneWay}">
        <TextBlock Text="ReportExtract" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <GroupBox Header="Workbook" Padding="14" Margin="0,0,0,12"><StackPanel><Button Content="Select Workbook" Command="{Binding ImportWorkbookCommand}" IsEnabled="{Binding CanStartInspection}" Width="145" HorizontalAlignment="Left"/><TextBlock Text="{Binding CurrentWorkbook.FileName, TargetNullValue=No workbook selected}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock Text="{Binding CurrentWorkbook.FullPath}" TextWrapping="Wrap"/></StackPanel></GroupBox>
        <GroupBox Header="Worksheet" Padding="14" Margin="0,0,0,12"><StackPanel><ComboBox ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedWorksheet}" DisplayMemberPath="DisplayName" Width="360" HorizontalAlignment="Left"/><CheckBox Content="Include hidden rows and columns" IsChecked="{Binding IncludeHiddenRowsAndColumns}" Margin="0,10,0,0"/><Button Content="Validate and Load Worksheet" Command="{Binding LoadDataCommand}" IsEnabled="{Binding CanLoadData}" Width="190" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></GroupBox>
        <GroupBox Header="Session" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding DataStateMessage}" FontWeight="SemiBold"/><TextBlock Text="MAVL is calculated from the complete eligible worksheet." Margin="0,6,0,0"/></StackPanel></GroupBox>
        <GroupBox Header="Filters and Presets" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding PartNumberFilterSummary, Mode=OneWay}"/><TextBlock Text="{Binding CategoryFilterSummary, Mode=OneWay}" Margin="0,6,0,0"/><TextBlock Text="{Binding ManufacturerFilterSummary, Mode=OneWay}" Margin="0,6,0,0"/><Button Content="Configure Filters" Click="OpenFilters_Click" IsEnabled="{Binding HasValidatedProcessingSession}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6"/></StackPanel></GroupBox>
        <GroupBox Header="Export" Padding="14"><StackPanel><Button Content="Export Filtered Workbook" Command="{Binding ExportFilteredWorkbookCommand}" Width="190" HorizontalAlignment="Left"/><TextBlock Text="Exports a new filtered workbook with MAVL." Margin="0,6,0,0"/></StackPanel></GroupBox>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#EEF1F3" Padding="12" Margin="24,14,24,24">
      <StackPanel>
        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap"/>
        <StackPanel Margin="0,10,0,0">
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExporting, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="{Binding ExportProgressText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsExportProgressIndeterminate, Mode=OneWay}" Height="18"/>
          <Button Content="Cancel Export" Command="{Binding CancelExportCommand, Mode=OneWay}" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
